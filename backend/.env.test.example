# Copy to .env.test and point to a dedicated test database.
# Integration tests RESET all WMS tables — never use production DATABASE_URL.
TEST_DATABASE_URL="postgresql://postgres:password@localhost:5432/wms_test?schema=public"

JWT_ACCESS_SECRET=test-access-secret-minimum-32-characters-long
JWT_REFRESH_SECRET=test-refresh-secret-minimum-32-characters-long
