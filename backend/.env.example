# Server
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Database
# Local:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/wms_db?schema=public"
# Neon (pooled connection – recommended for serverless/dev):
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&schema=public"

# JWT
JWT_ACCESS_SECRET=your-access-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Cloudflare R2 (S3-compatible object storage)
# 1. Cloudflare Dashboard → R2 → Create bucket (e.g. wms-files)
# 2. Manage R2 API Tokens → Create API token (Object Read & Write)
# 3. Account ID: Dashboard right sidebar / R2 overview
# 4. Optional public access: enable R2.dev subdomain or custom domain → set R2_PUBLIC_URL
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=wms-files
R2_PUBLIC_URL=

# Upload
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

# Rate Limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
