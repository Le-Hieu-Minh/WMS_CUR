generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum EntityStatus {
  ACTIVE
  INACTIVE
}

enum DocumentStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum AdjustmentType {
  INCREASE
  DECREASE
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  module      String
  roles       RolePermission[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                  String         @id @default(uuid())
  email               String         @unique
  passwordHash        String         @map("password_hash")
  fullName            String         @map("full_name")
  avatarUrl           String?        @map("avatar_url")
  status              UserStatus     @default(ACTIVE)
  roleId              String         @map("role_id")
  role                Role           @relation(fields: [roleId], references: [id])
  failedLoginAttempts Int            @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?      @map("locked_until")
  lastLoginAt         DateTime?      @map("last_login_at")
  refreshTokens          RefreshToken[]
  goodsReceiptsCreated   GoodsReceipt[] @relation("GoodsReceiptCreatedBy")
  goodsReceiptsConfirmed GoodsReceipt[] @relation("GoodsReceiptConfirmedBy")
  goodsIssuesCreated     GoodsIssue[]   @relation("GoodsIssueCreatedBy")
  goodsIssuesConfirmed   GoodsIssue[]   @relation("GoodsIssueConfirmedBy")
  stockTakesCreated         StockTake[]        @relation("StockTakeCreatedBy")
  stockTakesConfirmed       StockTake[]        @relation("StockTakeConfirmedBy")
  stockAdjustmentsCreated   StockAdjustment[]  @relation("StockAdjustmentCreatedBy")
  stockAdjustmentsConfirmed StockAdjustment[]  @relation("StockAdjustmentConfirmedBy")
  auditLogs                 AuditLog[]
  createdAt                 DateTime           @default(now()) @map("created_at")
  updatedAt                 DateTime           @updatedAt @map("updated_at")

  @@index([status])
  @@index([roleId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Warehouse {
  id            String         @id @default(uuid())
  code          String         @unique
  name          String
  address       String?
  phone         String?
  email         String?
  description   String?
  status        EntityStatus   @default(ACTIVE)
  inventories   Inventory[]
  goodsReceipts GoodsReceipt[]
  goodsIssues       GoodsIssue[]
  stockTakes        StockTake[]
  stockAdjustments  StockAdjustment[]
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  @@index([status])
  @@map("warehouses")
}

model Product {
  id                 String             @id @default(uuid())
  code               String             @unique
  name               String
  description        String?
  category           String?
  unit               String             @default("pcs")
  price              Decimal            @default(0) @db.Decimal(15, 2)
  costPrice          Decimal            @default(0) @map("cost_price") @db.Decimal(15, 2)
  minStock           Int                @default(0) @map("min_stock")
  imageUrl           String?            @map("image_url")
  status             EntityStatus       @default(ACTIVE)
  inventories        Inventory[]
  goodsReceiptItems  GoodsReceiptItem[]
  goodsIssueItems    GoodsIssueItem[]
  stockTakeItems         StockTakeItem[]
  stockAdjustmentItems   StockAdjustmentItem[]
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  @@index([status])
  @@index([category])
  @@map("products")
}

model Supplier {
  id            String         @id @default(uuid())
  code          String         @unique
  name          String
  contactPerson String?        @map("contact_person")
  phone         String?
  email         String?
  address       String?
  notes         String?
  status        EntityStatus   @default(ACTIVE)
  goodsReceipts GoodsReceipt[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@index([status])
  @@map("suppliers")
}

model Customer {
  id            String       @id @default(uuid())
  code          String       @unique
  name          String
  contactPerson String?      @map("contact_person")
  phone         String?
  email         String?
  address       String?
  notes         String?
  status        EntityStatus @default(ACTIVE)
  goodsIssues   GoodsIssue[]
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@index([status])
  @@map("customers")
}

model Inventory {
  id          String    @id @default(uuid())
  warehouseId String    @map("warehouse_id")
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  productId   String    @map("product_id")
  product     Product   @relation(fields: [productId], references: [id])
  quantity    Decimal   @default(0) @db.Decimal(15, 3)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([warehouseId, productId])
  @@index([warehouseId])
  @@index([productId])
  @@map("inventories")
}

model GoodsReceipt {
  id              String             @id @default(uuid())
  code            String             @unique
  warehouseId     String             @map("warehouse_id")
  warehouse       Warehouse          @relation(fields: [warehouseId], references: [id])
  supplierId      String?            @map("supplier_id")
  supplier        Supplier?          @relation(fields: [supplierId], references: [id])
  status          DocumentStatus     @default(DRAFT)
  receiptDate     DateTime           @map("receipt_date") @db.Date
  note            String?
  createdById     String             @map("created_by_id")
  createdBy       User               @relation("GoodsReceiptCreatedBy", fields: [createdById], references: [id])
  confirmedById   String?            @map("confirmed_by_id")
  confirmedBy     User?              @relation("GoodsReceiptConfirmedBy", fields: [confirmedById], references: [id])
  confirmedAt     DateTime?          @map("confirmed_at")
  items           GoodsReceiptItem[]
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@index([status])
  @@index([warehouseId])
  @@index([supplierId])
  @@index([receiptDate])
  @@index([createdById])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id             String       @id @default(uuid())
  goodsReceiptId String       @map("goods_receipt_id")
  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  productId      String       @map("product_id")
  product        Product      @relation(fields: [productId], references: [id])
  quantity       Decimal      @db.Decimal(15, 3)
  unitCost       Decimal      @default(0) @map("unit_cost") @db.Decimal(15, 2)
  note           String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([goodsReceiptId])
  @@index([productId])
  @@map("goods_receipt_items")
}

model GoodsIssue {
  id            String           @id @default(uuid())
  code          String           @unique
  warehouseId   String           @map("warehouse_id")
  warehouse     Warehouse        @relation(fields: [warehouseId], references: [id])
  customerId    String?          @map("customer_id")
  customer      Customer?        @relation(fields: [customerId], references: [id])
  status        DocumentStatus   @default(DRAFT)
  issueDate     DateTime         @map("issue_date") @db.Date
  note          String?
  createdById   String           @map("created_by_id")
  createdBy     User             @relation("GoodsIssueCreatedBy", fields: [createdById], references: [id])
  confirmedById String?          @map("confirmed_by_id")
  confirmedBy   User?            @relation("GoodsIssueConfirmedBy", fields: [confirmedById], references: [id])
  confirmedAt   DateTime?        @map("confirmed_at")
  items         GoodsIssueItem[]
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@index([status])
  @@index([warehouseId])
  @@index([customerId])
  @@index([issueDate])
  @@index([createdById])
  @@map("goods_issues")
}

model GoodsIssueItem {
  id           String     @id @default(uuid())
  goodsIssueId String     @map("goods_issue_id")
  goodsIssue   GoodsIssue @relation(fields: [goodsIssueId], references: [id], onDelete: Cascade)
  productId    String     @map("product_id")
  product      Product    @relation(fields: [productId], references: [id])
  quantity     Decimal    @db.Decimal(15, 3)
  unitPrice    Decimal    @default(0) @map("unit_price") @db.Decimal(15, 2)
  note         String?
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@index([goodsIssueId])
  @@index([productId])
  @@map("goods_issue_items")
}

model StockTake {
  id            String          @id @default(uuid())
  code          String          @unique
  warehouseId   String          @map("warehouse_id")
  warehouse     Warehouse       @relation(fields: [warehouseId], references: [id])
  status        DocumentStatus  @default(DRAFT)
  takeDate      DateTime        @map("take_date") @db.Date
  note          String?
  createdById   String          @map("created_by_id")
  createdBy     User            @relation("StockTakeCreatedBy", fields: [createdById], references: [id])
  confirmedById String?         @map("confirmed_by_id")
  confirmedBy   User?           @relation("StockTakeConfirmedBy", fields: [confirmedById], references: [id])
  confirmedAt   DateTime?       @map("confirmed_at")
  items         StockTakeItem[]
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@index([status])
  @@index([warehouseId])
  @@index([takeDate])
  @@index([createdById])
  @@map("stock_takes")
}

model StockTakeItem {
  id          String    @id @default(uuid())
  stockTakeId String    @map("stock_take_id")
  stockTake   StockTake @relation(fields: [stockTakeId], references: [id], onDelete: Cascade)
  productId   String    @map("product_id")
  product     Product   @relation(fields: [productId], references: [id])
  systemQty   Decimal   @map("system_qty") @db.Decimal(15, 3)
  countedQty  Decimal   @map("counted_qty") @db.Decimal(15, 3)
  note        String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([stockTakeId, productId])
  @@index([stockTakeId])
  @@index([productId])
  @@map("stock_take_items")
}

model StockAdjustment {
  id            String                @id @default(uuid())
  code          String                @unique
  warehouseId   String                @map("warehouse_id")
  warehouse     Warehouse             @relation(fields: [warehouseId], references: [id])
  status        DocumentStatus        @default(DRAFT)
  adjustDate    DateTime              @map("adjust_date") @db.Date
  reason        String
  note          String?
  createdById   String                @map("created_by_id")
  createdBy     User                  @relation("StockAdjustmentCreatedBy", fields: [createdById], references: [id])
  confirmedById String?               @map("confirmed_by_id")
  confirmedBy   User?                 @relation("StockAdjustmentConfirmedBy", fields: [confirmedById], references: [id])
  confirmedAt   DateTime?             @map("confirmed_at")
  items         StockAdjustmentItem[]
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  @@index([status])
  @@index([warehouseId])
  @@index([adjustDate])
  @@index([createdById])
  @@map("stock_adjustments")
}

model StockAdjustmentItem {
  id                String          @id @default(uuid())
  stockAdjustmentId String          @map("stock_adjustment_id")
  stockAdjustment   StockAdjustment @relation(fields: [stockAdjustmentId], references: [id], onDelete: Cascade)
  productId         String          @map("product_id")
  product           Product         @relation(fields: [productId], references: [id])
  type              AdjustmentType
  quantity          Decimal         @db.Decimal(15, 3)
  note              String?
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@unique([stockAdjustmentId, productId])
  @@index([stockAdjustmentId])
  @@index([productId])
  @@map("stock_adjustment_items")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  module      String
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id")
  description String?
  oldData     Json?    @map("old_data")
  newData     Json?    @map("new_data")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([action])
  @@index([module])
  @@index([entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}
